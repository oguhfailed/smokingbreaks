# ──────────────────────────────────────────────────────────────────────────────
# Twitter / X API credentials (OAuth 1.0a — required for retweet actions)
#
# Get these from https://developer.twitter.com/en/portal/dashboard
# Your app needs "Read and Write" permissions.
# ──────────────────────────────────────────────────────────────────────────────

TWITTER_APP_KEY=your_api_key_here
TWITTER_APP_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_token_secret_here

# ──────────────────────────────────────────────────────────────────────────────
# Bot configuration (all optional — defaults shown)
# ──────────────────────────────────────────────────────────────────────────────

# Comma-separated list of Twitter usernames to track (no @ prefix needed).
# Defaults to the 5 most-followed accounts.
TOP_PROFILES=elonmusk,barackobama,justinbieber,katyperry,rihanna

# How often (in minutes) to poll for new tweets throughout the day.
CHECK_INTERVAL_MINUTES=30

# Hour of day (0-23, local time) at which the main daily job runs.
RUN_HOUR=8
